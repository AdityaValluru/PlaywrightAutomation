<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    testng-smoke.xml — TestNG launcher for SMOKE tests only.

    Runs only tests tagged with the "smoke" group.
    Intended for a quick sanity check after a deployment.
    Execute via:  mvn test -P smoke
    Or directly:  mvn test -DsuiteXmlFile=src/test/resources/testng/testng-smoke.xml
-->
<suite name="Smoke Test Suite" verbose="1" parallel="tests" thread-count="2">

    <listeners>
        <listener class-name="com.framework.listeners.TestNGListener"/>
    </listeners>

    <!-- ================================================================ -->
    <!-- Login Page — Smoke Tests                                          -->
    <!-- ================================================================ -->
    <test name="Login Page — Smoke" preserve-order="true">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.framework.tests.loginpage.LoginPageTest"/>
        </classes>
    </test>

    <!-- ================================================================ -->
    <!-- Home Page — Smoke Tests                                           -->
    <!-- ================================================================ -->
    <test name="Home Page — Smoke" preserve-order="true">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.framework.tests.homepage.HomePageTest"/>
        </classes>
    </test>

</suite>
