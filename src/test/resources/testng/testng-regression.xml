<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    testng-regression.xml — TestNG launcher for REGRESSION tests.

    Runs all tests tagged with the "regression" group across all page classes.
    Intended for full regression passes (e.g. nightly builds, pre-release).
    Execute via:  mvn test -P regression
    Or directly:  mvn test -DsuiteXmlFile=src/test/resources/testng/testng-regression.xml
-->
<suite name="Regression Test Suite" verbose="1" parallel="tests" thread-count="4">

    <listeners>
        <listener class-name="com.framework.listeners.TestNGListener"/>
    </listeners>

    <!-- ================================================================ -->
    <!-- Login Page — Regression Tests                                     -->
    <!-- ================================================================ -->
    <test name="Login Page — Regression" preserve-order="true">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.framework.tests.loginpage.LoginPageTest"/>
        </classes>
    </test>

    <!-- ================================================================ -->
    <!-- Home Page — Regression Tests                                      -->
    <!-- ================================================================ -->
    <test name="Home Page — Regression" preserve-order="true">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.framework.tests.homepage.HomePageTest"/>
        </classes>
    </test>

</suite>
